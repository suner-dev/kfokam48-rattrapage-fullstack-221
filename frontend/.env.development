# Base de l'API appelée par l'écran (aucune URL dans le code des composants).
# 127.0.0.1 plutôt que localhost : selon la résolution DNS du navigateur,
# localhost peut pointer sur ::1 alors que Tomcat n'écoute que sur la pile IPv4.
VITE_API_URL=http://127.0.0.1:8080
# Port du serveur de développement Vite.
VITE_DEV_PORT=5173
